{
  // KingIndex v2 — staging only
  // Public: https://v2.kingindex.tanishqnalloju.com
  // Do NOT deploy to Worker name ppp-index-calculator or apex kingindex.tanishqnalloju.com
  "name": "kingindex-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "v2.kingindex.tanishqnalloju.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
